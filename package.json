{
  "name": "dr-christeen-youssef",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --ignore ./src --ignore ./dist server/index.ts --dev",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && npm run build:prerender && npm run build:server",
    "build:prerender": "esbuild scripts/prerender.ts --bundle --platform=node --format=esm --target=node20.19 --packages=external --log-level=warning --outfile=dist/server/prerender.js && node dist/server/prerender.js",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20.19 --packages=external --log-level=warning --outfile=dist/node/server.js",
    "start": "node dist/node/server.js",
    "preview": "npm run build && npm start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "compression": "^1.8.2",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.72.1",
    "react-icons": "^5.7.0",
    "react-router": "^7.18.5",
    "shadcn": "^4.19.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.3.5",
    "vite-imagetools": "^12.0.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
